[node name="ActionResponseLabel" type="Label" parent="MainUIMargin/UI/TextDisplayArea/MainTextArea/MainTextMargin/MainTextArea"]
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 0.48
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_constants/line_spacing = 5
theme_override_fonts/font = ExtResource("1_uwrxv")
theme_override_font_sizes/font_size = 20
text = "这个破旧的房间逼仄又安静。佐音躺在床上，你双手落在他两侧，膝盖抵着床垫，就这么把自己支起来，从上方看向他。

他的眼神和你对视，却又马上躲闪开。竟然这么腼腆，你们真的太久没见了不是吗？你有点想笑。嗯，你的确是太心急了，连休息的时间也不给他。谁让你自己的时间已经不多了呢？

几缕发丝不老实地从你肩上滑落，垂在他脸上。"
autowrap_mode = 3

[node name="HintLabel" type="RichTextLabel" parent="MainUIMargin/UI/TextDisplayArea/MainTextArea/MainTextMargin/MainTextArea"]
visible = false
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 0.12
theme_override_colors/default_color = Color(1, 1, 1, 1)
theme_override_constants/line_separation = 5
theme_override_fonts/normal_font = ExtResource("1_uwrxv")
theme_override_font_sizes/normal_font_size = 20
bbcode_enabled = true
text = "[color=red]你的精神状态和身体状况岌岌可危，要谨慎。[/color]"
vertical_alignment = 1

