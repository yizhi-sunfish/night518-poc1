[node name="PlayerStatusLabel" type="RichTextLabel" parent="MainUIMargin/UI/TextDisplayArea"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
size_flags_stretch_ratio = 0.2
theme_override_constants/line_separation = 5
theme_override_fonts/normal_font = ExtResource("1_uwrxv")
theme_override_font_sizes/normal_font_size = 20
bbcode_enabled = true
text = "[color=red]你感觉糟透了，焦虑在你身体里横冲直撞，有什么东西要溢出来，你分辨不清，总之不会是好东西。
佐音正在看着你，他的目光透露出担忧……有什么好担忧的？看了就让人烦躁。[/color]"
scroll_active = false

